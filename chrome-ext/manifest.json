{
  "manifest_version": 3,
  "name": "CryptoTrace",
  "version": "0.5.0",
  "description": "Trace client-side crypto calls while debugging and send the key/algorithm config to the CryptoTrace Burp extension.",
  "permissions": [
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "devtools_page": "devtools.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CryptoTrace",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
